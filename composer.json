{
    "name": "concatenate/indonesian-regions",
    "description": "Indonesian Region Database",
    "license": "MIT",
    "authors": [
        {
            "name": "Harry Mahardhika",
            "email": "harry@concatenate.id",
            "homepage": "http://harrymahardhika.com"
        }
    ],
    "homepage": "https://github.com/concatenate/indonesian-regions",
    "keywords": [
        "laravel",
        "indonesian-regions"
    ],
    "require": {
        "php": "^8.0|^8.1",
        "jawira/case-converter": "^3.4",
        "spatie/laravel-data": "^3.0.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "orchestra/testbench": "~5|~6|~7",
        "parsecsv/php-parsecsv": "^1.3",
        "phpunit/phpunit": "~9.0"
    },
    "autoload": {
        "psr-4": {
            "Concatenate\\IndonesianRegions\\": "src/",
            "Concatenate\\IndonesianRegions\\Database\\Factories\\": "database/factories/",
            "Concatenate\\IndonesianRegions\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Concatenate\\IndonesianRegions\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Concatenate\\IndonesianRegions\\IndonesianRegionsServiceProvider"
            ],
            "aliases": {
                "IndonesianRegions": "Concatenate\\IndonesianRegions\\Facades\\IndonesianRegions"
            }
        }
    },
    "scripts": {
        "fix": "vendor/bin/php-cs-fixer fix --config=.php_cs.dist.php"
    }
}
