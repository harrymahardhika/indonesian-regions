{
    "name": "harrym/indonesian-regions",
    "description": "Indonesian Region Database for Laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Harry Mahardhika",
            "email": "harry@infinitidea.id",
            "homepage": "http://harrymahardhika.com"
        }
    ],
    "homepage": "https://github.com/concatenate/indonesian-regions",
    "keywords": [
        "laravel",
        "indonesian-regions"
    ],
    "require": {
        "php": "^8.2",
        "spatie/laravel-data": "^4.0.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.5",
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpunit/phpunit": "^11.0",
        "rector/rector": "^2.6",
        "phpstan/phpstan": "^2.2",
        "larastan/larastan": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "HarryM\\IndonesianRegions\\": "src/",
            "HarryM\\IndonesianRegions\\Database\\Factories\\": "database/factories/",
            "HarryM\\IndonesianRegions\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HarryM\\IndonesianRegions\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "HarryM\\IndonesianRegions\\IndonesianRegionsServiceProvider"
            ],
            "aliases": {
                "IndonesianRegions": "HarryM\\IndonesianRegions\\Facades\\IndonesianRegions"
            }
        }
    },
    "scripts": {
        "pint": "vendor/bin/pint",
        "rector": "vendor/bin/rector process",
        "test": "vendor/bin/pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
